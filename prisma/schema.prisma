generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  STAFF
}

enum JobWorkMode {
  ONSITE
  HYBRID
  REMOTE
  FLEXIBLE
}

enum JobPostingStatus {
  ACTIVE
  CLOSED
}

enum ApplicationStatus {
  SAVED
  PREPARING
  READY_FOR_REVIEW
  SUBMITTED
  INTERVIEW
  REJECTED
  OFFER
  WITHDRAWN
}

enum JobSyncTaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                          String              @id @default(cuid())
  name                        String?
  email                       String              @unique
  emailVerified               DateTime?
  image                       String?
  passwordHash                String?
  role                        UserRole            @default(USER)
  twoFactorEnabled            Boolean             @default(false)
  twoFactorMethod             String?
  twoFactorEmailCodeHash      String?
  twoFactorEmailCodeExpiresAt DateTime?
  twoFactorEmailCodeAttempts  Int                 @default(0)
  twoFactorPendingSecretCipher String?
  twoFactorSecretCipher       String?
  twoFactorLastTotpCounter    BigInt?
  recoveryCodeHashes          String[]            @default([])
  emailVerificationCodeHash   String?
  emailVerificationExpiresAt  DateTime?
  emailVerificationAttempts   Int                 @default(0)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  accounts                    Account[]
  sessions                    Session[]
  profile                     JobProfile?
  jobPreferences              UserJobPreference?
  applications                Application[]
  savedJobs                   SavedJob[]
  auditEvents                 AuditEvent[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model JobProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String?
  location        String   @default("Anywhere")
  cvFileKey       String?
  skills          String[]
  experienceYears Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserJobPreference {
  id                     String        @id @default(cuid())
  userId                 String        @unique
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCountries     String[]      @default([])
  preferredRegions       String[]      @default([])
  preferredCities        String[]      @default([])
  preferredWorkModes     JobWorkMode[] @default([])
  employmentTypes        String[]      @default([])
  jobCategories          String[]      @default([])
  interfaceLanguage      String        @default("en")
  nativeLanguage         String?
  jobDescriptionLanguage String        @default("en")
  applicationLanguage    String        @default("en")
  communicationLanguage  String        @default("en")
  additionalLanguages    String[]      @default([])
  worldwideSearch        Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model JobPosting {
  id                String           @id @default(cuid())
  source            String
  sourceJobId       String
  title             String
  company           String
  salaryText        String?
  employmentType    String?
  jobCategory       String?
  description       String?          @db.Text
  sourceLanguage    String?
  applicationUrl    String?
  sourceUrl         String?
  locationText      String
  city              String?
  state             String?
  country           String?
  workMode          JobWorkMode      @default(ONSITE)
  eligibleLocations String[]         @default([])
  publishedAt       DateTime?
  discoveredAt      DateTime         @default(now())
  expiresAt         DateTime?
  status            JobPostingStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  savedBy           SavedJob[]
  applications      Application[]

  @@unique([source, sourceJobId])
  @@index([status, publishedAt])
  @@index([city, state, country])
  @@index([country, status, city, publishedAt])
  @@index([country, status, workMode, publishedAt])
}

model SavedJob {
  id           String     @id @default(cuid())
  userId       String
  jobPostingId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobPostingId])
  @@index([userId, createdAt])
}

model Application {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostingId String?
  jobPosting   JobPosting?       @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  company      String
  jobTitle     String
  jobUrl       String?
  workLocation String
  workMode     String?
  source       String?
  publishedAt  DateTime?
  status       ApplicationStatus @default(SAVED)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([userId, jobPostingId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String?
  resourceId String?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}


model JobSyncTask {
  id            String            @id @default(cuid())
  dedupeKey     String            @unique
  status        JobSyncTaskStatus @default(PENDING)
  attempts      Int               @default(0)
  runAt         DateTime          @default(now())
  lockedAt      DateTime?
  lockExpiresAt DateTime?
  lockToken     String?
  completedAt   DateTime?
  lastError     String?           @db.Text
  result        Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, runAt])
  @@index([status, lockExpiresAt])
}
