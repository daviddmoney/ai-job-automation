# Copy to .env.local. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_job_automation?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
EMAIL_FROM="AI Job Automation <no-reply@example.com>"
EMAIL_PROVIDER_ORDER="resend,postmark,sendgrid"
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
SENDGRID_API_KEY=""
TOTP_ENCRYPTION_KEY="base64-encoded-32-byte-key"
STAFF_EMAIL=""
CONFIRM_STAFF_PROMOTION=""

# Global job-source identifiers (comma-separated approved employer boards).
GREENHOUSE_BOARD_TOKENS=""
LEVER_SITE_NAMES=""
ASHBY_BOARD_NAMES=""
JOOBLE_NG_API_KEY=""
CRON_SECRET=""

# Translation providers. Configure one or more; server-side only.
TRANSLATION_PROVIDER_ORDER="google,deepl,azure,aws,openai"
GOOGLE_TRANSLATE_API_KEY=""
DEEPL_API_KEY=""
DEEPL_API_BASE_URL=""
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_REGION=""
AWS_TRANSLATE_REGION=""
OPENAI_API_KEY=""
OPENAI_TRANSLATION_MODEL="gpt-4o-mini"

# Optional security scanning integration.
SNYK_TOKEN=""
