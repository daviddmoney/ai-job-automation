{
  "name": "ai-job-automation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "promote-staff": "node scripts/promote-staff.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node --experimental-strip-types --test tests/*.integration.mjs",
    "rate-limit:cleanup": "node scripts/cleanup-rate-limit-buckets.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.15.0",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "postcss": "^8.5.32",
    "effect": "3.22.1"
  }
}
